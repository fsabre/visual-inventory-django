# The hostname on which the app will be available.
# Don't specify a port number.
# Ex: localhost
HOST=...
# A secret used to cipher Django-related things.
# Ex: zx4376RkEqBH7Y3q8Ng9SpxR6mkmzzM88nfd9xdd
DJANGO_SECRET_KEY=zx4376RkEqBH7Y3q8Ng9SpxR6mkmzzM88nfd9xdd
# Set to true to enable the debug mode of Django
# Ex: true
DJANGO_DEBUG=false
